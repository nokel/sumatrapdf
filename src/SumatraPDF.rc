IDD_DIALOG_PARTITION_NAME DIALOGEX 0, 0, 220, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Partition"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Name this partition:",IDC_PARTITION_NAME_LABEL,6,7,208,18
    EDITTEXT        IDC_PARTITION_NAME_EDIT,6,28,208,13,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,110,44,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,164,44,50,14
END

IDD_DIALOG_RENAME_SERIES DIALOGEX 0, 0, 240, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename series"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&New series name:",IDC_RENAME_SERIES_LABEL,6,7,228,18
    EDITTEXT        IDC_RENAME_SERIES_EDIT,6,28,228,13,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,128,50,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,184,50,50,14
END

IDD_DIALOG_BOOK_METADATA DIALOGEX 0, 0, 400, 240
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit book metadata"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "File: <filename>",IDC_BOOK_PATH_LABEL,6,4,388,10
    LTEXT           "&Title:",IDC_BOOK_TITLE_LABEL,6,22,72,12
    EDITTEXT        IDC_BOOK_TITLE_EDIT,80,20,260,14,ES_AUTOHSCROLL
    LTEXT           "source: (auto)",IDC_BOOK_TITLE_SOURCE,80,36,260,10
    PUSHBUTTON      "Revert",IDC_BOOK_REVERT_TITLE,344,20,50,14

    LTEXT           "&Author:",IDC_BOOK_AUTHOR_LABEL,6,62,72,12
    EDITTEXT        IDC_BOOK_AUTHOR_EDIT,80,60,260,14,ES_AUTOHSCROLL
    LTEXT           "source: (auto)",IDC_BOOK_AUTHOR_SOURCE,80,76,260,10
    PUSHBUTTON      "Revert",IDC_BOOK_REVERT_AUTHOR,344,60,50,14

    LTEXT           "&Series:",IDC_BOOK_SERIES_LABEL,6,102,72,12
    EDITTEXT        IDC_BOOK_SERIES_EDIT,80,100,260,14,ES_AUTOHSCROLL
    LTEXT           "source: (auto)",IDC_BOOK_SERIES_SOURCE,80,116,260,10
    PUSHBUTTON      "Revert",IDC_BOOK_REVERT_SERIES,344,100,50,14

    LTEXT           "&Year:",IDC_BOOK_YEAR_LABEL,6,142,72,12
    EDITTEXT        IDC_BOOK_YEAR_EDIT,80,140,100,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "source: (auto)",IDC_BOOK_YEAR_SOURCE,80,156,260,10
    PUSHBUTTON      "Revert",IDC_BOOK_REVERT_YEAR,344,140,50,14

    DEFPUSHBUTTON   "Save",IDOK,272,220,56,14
    PUSHBUTTON      "Cancel",IDCANCEL,338,220,56,14
    PUSHBUTTON      "Clear all overrides",IDC_BOOK_CLEAR_OVERRIDES,6,220,110,14
END

IDD_PROPSHEET_PRINT_ADVANCED DIALOGEX 0, 0, 292, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Advanced"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Print range",IDC_SECTION_PRINT_RANGE,7,7,278,52
    CONTROL         "&All selected pages",IDC_PRINT_RANGE_ALL,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,18,264,9
    CONTROL         "&Odd pages only",IDC_PRINT_RANGE_ODD,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,31,264,9
    CONTROL         "&Even pages only",IDC_PRINT_RANGE_EVEN,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,44,264,9
    GROUPBOX        "Page scaling",IDC_SECTION_PRINT_SCALE,7,62,278,65
    CONTROL         "&Shrink pages to printable area (if necessary)",IDC_PRINT_SCALE_SHRINK,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,74,264,9
    CONTROL         "&Fit pages to printable area",IDC_PRINT_SCALE_FIT,
                    "Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,87,264,9
    CONTROL         "S&tretch pages to fill paper (ignore aspect ratio)",IDC_PRINT_SCALE_STRETCH,
                    "Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,100,264,9
    CONTROL         "&Use original page sizes",IDC_PRINT_SCALE_NONE,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,14,113,264,9
    CONTROL         "Center page hori&zontally on the paper",IDC_PRINT_CENTER_HORIZONTALLY,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,133,278,10
    CONTROL         "Choose &paper source by document page size",IDC_PRINT_PAPER_SOURCE_BY_SIZE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,146,278,10
    CONTROL         "Print each page at its &document page size (mixed sizes)",IDC_PRINT_PER_PAGE_PAPER_SIZE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,159,278,10
    LTEXT           "&Rotate printout:",IDC_PRINT_ROTATE_LABEL,7,175,72,9
    COMBOBOX        IDC_PRINT_ROTATE,82,173,90,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

